# Copy this file to .env and fill in your real Supabase project values.
# The app runs fine WITHOUT these set (it falls back to local demo/mock data),
# but real persistence, auth, and the 8 database tables only work once these
# are filled in and you restart `npm run dev`.

VITE_SUPABASE_URL=INSERT_YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=INSERT_YOUR_SUPABASE_ANON_KEY
